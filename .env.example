# Copy this file to .env and edit it. Never commit .env.

# Display name used in menus and the pairing browser label
BOT_NAME=RETRO

# Owner's WhatsApp number, digits only, with country code (no +, no spaces)
OWNER_NUMBER=2348000000000

# Command prefixes, comma separated
PREFIX=.,/,!

# public = anyone can use commands, self = only owner and the bot's own account
MODE=public

# Timezone for the .time command (IANA name)
TIMEZONE=Africa/Lagos

# Per-user cooldown between commands, in milliseconds
COOLDOWN_MS=2000

# Optional: set to the bot's number to pair with an 8-character code instead of a QR scan
PAIRING_NUMBER=

# Where the WhatsApp session is stored. Treat this folder like a password.
SESSION_DIR=./session

# Baileys log level: silent, error, warn, info, debug
LOG_LEVEL=silent
